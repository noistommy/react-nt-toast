{
  "name": "react-nt-toast",
  "description": "Toast system context with react",
  "author": "Minyoung Tommy Kim",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "MODE=demo vite",
    "build": "npm run build:code",
    "build:code": "MODE=lib vite build",
    "build:demo": "MODE=demo vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "docs": "rm -rf docs && cp -rf demo/dist docs"
  },
  "main": "./dist/nt-toast.umd.js",
  "module": "./dist/nt-toast.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nt-toast.es.js",
      "require": "./dist/nt-toast.umd.js"
    },
    "./nt-toast.css": "./dist/nt-toast.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "bugs": {
    "url": "https://github.com/noistommy/react-nt-toast/issues"
  },
  "homepage": "https://noistommy.github.io/react-nt-toast",
  "keywords": [
    "react",
    "notification",
    "toast"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "nt-cabinet-component": "github:noistommy/nt-cabinet-component",
    "react-be-ui": "^0.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sass": "^1.93.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noistommy/react-nt-toast.git"
  }
}
